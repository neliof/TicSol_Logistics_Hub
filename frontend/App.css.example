.app {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: var(--color-neutral-50);
}

.app-header {
  background: var(--color-primary-700);
  color: white;
  padding: 1.5rem;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.app-header h1 {
  margin: 0 0 1rem 0;
  font-size: 1.75rem;
  font-family: IBM Plex Mono, monospace;
}

.app-nav {
  display: flex;
  gap: 0.5rem;
}

.nav-btn {
  padding: 0.75rem 1.25rem;
  background: var(--color-primary-600);
  color: white;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  font-size: 0.95rem;
  font-weight: 600;
  transition: background 0.2s;
}

.nav-btn:hover {
  background: var(--color-primary-500);
}

.nav-btn.active {
  background: var(--color-secondary-500);
}

.app-main {
  flex: 1;
  padding: 2rem;
  max-width: 1400px;
  margin: 0 auto;
  width: 100%;
}

.app-footer {
  background: var(--color-neutral-200);
  color: var(--color-neutral-700);
  text-align: center;
  padding: 1rem;
  margin-top: 2rem;
  border-top: 1px solid var(--color-neutral-300);
}

.app-footer p {
  margin: 0;
  font-size: 0.875rem;
}

/* Mobile */
@media (max-width: 640px) {
  .app-header {
    padding: 1rem;
  }

  .app-header h1 {
    font-size: 1.25rem;
  }

  .app-main {
    padding: 1rem;
  }

  .app-nav {
    flex-wrap: wrap;
  }

  .nav-btn {
    flex: 1;
    min-width: 140px;
  }
}
