import '../shared/tokens.css'
import Reception from './receção/Reception'
import Paletizacao from './paletizacao/Paletizacao'
import { useState } from 'react'
import './App.css'

export default function App() {
  const [view, setView] = useState('reception')

  return (
    <div className="app">
      <header className="app-header">
        <h1>TicSol Logistics Hub</h1>
        <nav className="app-nav">
          <button
            className={`nav-btn ${view === 'reception' ? 'active' : ''}`}
            onClick={() => setView('reception')}
          >
            📦 Receção
          </button>
          <button
            className={`nav-btn ${view === 'paletizacao' ? 'active' : ''}`}
            onClick={() => setView('paletizacao')}
          >
            📊 Paletização
          </button>
        </nav>
      </header>

      <main className="app-main">
        {view === 'reception' && <Reception />}
        {view === 'paletizacao' && <Paletizacao />}
      </main>

      <footer className="app-footer">
        <p>TicSol Logistics Hub © 2024</p>
      </footer>
    </div>
  )
}
