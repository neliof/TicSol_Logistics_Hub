# Escolhe UM conector: rest | odbc | file
CONNECTOR_TYPE=file

# --- Conector REST (se CONNECTOR_TYPE=rest) ---
ARTSOFT_REST_URL=http://192.168.1.120:4219
ARTSOFT_REST_API_KEY=

# --- Conector ODBC (se CONNECTOR_TYPE=odbc) ---
ARTSOFT_ODBC_DSN=ARTSOFT_PERVASIVE
ARTSOFT_ODBC_USER=
ARTSOFT_ODBC_PASSWORD=

# --- Conector de ficheiros (se CONNECTOR_TYPE=file) ---
ARTSOFT_FILES_PATH=/caminho/para/pasta/de/exports
ARTSOFT_FILES_DELIMITER=;

# --- Ligação ao TicSol Logistics Hub ---
LOGISTICS_HUB_API_URL=http://localhost:3001
LOGISTICS_HUB_SYNC_TOKEN=
EMPRESA_ID=11111111-1111-1111-1111-111111111111
