# TicSol API Server Configuration

# Port (default: 3000)
PORT=3000

# Database connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ticsol_logistics_hub
DB_USER=app_user
DB_PASSWORD=your_secure_password_here

# JWT authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_minimum_32_chars

# Node environment
NODE_ENV=development
